{
  "name": "worker-proxy",
  "version": "1.0.0",
  "description": "Cloudflare Workers based proxy server",
  "type": "module",
  "main": "src/index.ts",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "update-config": "bun scripts/update-proxy-config.ts",
    "backup-config": "bun scripts/backup-config.ts [dir]",
    "restore-config": "bun scripts/restore-config.ts <file> [--dry-run] [--yes] [--replace]",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "eslint src/ scripts/ tests/",
    "lint:fix": "eslint src/ scripts/ tests/ --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251004.0",
    "@types/node": "^24.6.2",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.42.0"
  }
}
